datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id         String             @id @default(uuid())
  name       String
  email      String             @unique
  password   String
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")
  interviews InterviewSession[]

  @@map("users")
}

model InterviewSession {
  id                  String              @id @default(uuid())
  userId              String              @map("user_id")
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  title               String
  role                String
  difficulty          String
  overallScore        Int?                @map("overall_score")
  feedbackSummary     String?             @map("feedback_summary")
  personalizedRoadmap String?             @map("personalized_roadmap")
  status              String              // "DRAFT", "IN_PROGRESS", "COMPLETED"
  questions           InterviewQuestion[]
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  @@map("interview_sessions")
}

model InterviewQuestion {
  id           String           @id @default(uuid())
  sessionId    String           @map("session_id")
  session      InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionText String           @map("question_text")
  orderIndex   Int              @map("order_index")
  userAnswer   String?          @map("user_answer")
  aiScore      Int?             @map("ai_score")
  aiFeedback   String?          @map("ai_feedback")
  modelAnswer  String?          @map("model_answer")
  createdAt    DateTime         @default(now()) @map("created_at")

  @@map("interview_questions")
}
